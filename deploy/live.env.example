# Configure KPanel HTTPS, target-network validation, and an authorized pilot first.
MFA_MODE=live
MFA_LOCAL_DEV=0
MFA_ORIGIN=https://REPLACE-WITH-YOUR-DOMAIN
MFA_BIND_IP=127.0.0.1
MFA_PORT=8790
MFA_ACCESS_KEY=
MFA_MAX_CONCURRENT=10
MFA_GLOBAL_MAX_CONCURRENT=30
MFA_MEMORY_LIMIT=1536m
MFA_CPU_LIMIT=2.0
